{
  "compilerOptions": {
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "moduleResolution": "bundler", "module": "esnext", "target": "es2022", "lib": ["dom", "dom.iterable", "es2022"],
    "noEmit": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
